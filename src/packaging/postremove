#!/bin/sh
set -e

do_systemd() {
    # collectd
    systemctl disable collectd ||:
    if [ -d /run/systemd/system ]; then
        systemctl restart collectd ||:
    fi
}

do_initd() {
    service collectd stop ||:
}

if command -V systemctl >/dev/null 2>&1; then
    do_systemd
else
    do_initd
fi
